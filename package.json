{
  "name": "tonihaya-calendar",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/externalize-inline-scripts.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:headers": "node scripts/check-headers.mjs",
    "generate:images": "node scripts/generate-images.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run type-check && npm run format:check && npm run test",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lighthouse": "node scripts/lighthouse.mjs",
    "ci:lhci": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "happy-dom": "^21.0.4",
    "lighthouse": "^13.4.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "next": "^15.5.28",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
