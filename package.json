{
  "name": "tonihaya-calendar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run type-check && npm run format:check && npm run test",
    "prepare": "husky || true",
    "secrets": "secretlint \"**/*\"",
    "check:duplicates": "jscpd",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "@tailwindcss/postcss": "^4.3.2",
    "postcss": "^8.5.16",
    "@eslint/eslintrc": "^3.3.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "secretlint": "^13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "jscpd": "^5.4.2",
    "vitest": "^5.0.5",
    "@testing-library/jest-dom": "^7.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "secretlint"
    ]
  }
}
